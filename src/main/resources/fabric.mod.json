	"authors": ["You"],
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": ["com.swordfx.SwordFxClient"]
	},
	"mixins": [
		{ "config": "swordfx.mixins.json", "environment": "client" }
	],
	"depends": {
		"fabricloader": ">=0.19.0",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
